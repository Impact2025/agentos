# === Anthropic API — haal je sleutel op via console.anthropic.com ===
ANTHROPIC_API_KEY=sk-ant-your-key-here

# === Agent 1: Claude Sonnet (slim, gebalanceerd) ===
CLAUDE_MODEL=claude-sonnet-4-6

# === Agent 2: Hermes — kies één van de drie backends ===
#
# OPTIE A — Lokaal via Ollama (gratis, volledig privé)
#   1. Installeer Ollama: https://ollama.ai
#   2. Pull model: ollama pull qwen2.5-coder:7b
#   3. Zet OLLAMA_BASE_URL aan:
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b
# OPTIE B — OpenRouter (gratis tier beschikbaar, cloud)
#   1. Maak account op openrouter.ai
#   2. Kopieer API key:
# OPENROUTER_API_KEY=sk-or-your-key-here
# HERMES_MODEL=nousresearch/hermes-3-llama-3.1-405b:free
#
# OPTIE C — Anthropic fallback (geen extra config nodig)
#   Gebruikt automatisch Claude Haiku als A en B niet geconfigureerd zijn.
CLAUDE_MODEL_2=claude-haiku-4-5-20251001

# === Obsidian Vault ===
# Vul hier het absolute pad naar je Obsidian vault in
OBSIDIAN_VAULT_PATH=C:\Users\YourName\Documents\ObsidianVault

# === Google Analytics 4 ===
# 1. Maak een Google Cloud project aan en schakel de "Google Analytics Data API" in
# 2. Maak een service account aan en download het JSON-sleutelbestand
# 3. Voeg het service account toe aan je GA4 property als "Viewer"
# 4. Vul hieronder het Property ID in (te vinden in GA4 > Beheer > Property-instellingen)
GA4_PROPERTY_ID=123456789
GA_SERVICE_ACCOUNT_PATH=C:\pad\naar\service-account.json

# === Google Search Console (Demand Engine) ===
# De zoekwoord-databron van de Demand Engine. Hergebruikt standaard hetzelfde
# serviceaccount als GA4 — laat leeg om GA_SERVICE_ACCOUNT_PATH te gebruiken.
# BELANGRIJK: voeg het service-account-e-mailadres toe als gebruiker aan je
# Search Console-property (Instellingen > Gebruikers en machtigingen), anders 403.
# Per site stel je de GSC-property in via het dashboard (bijv. sc-domain:example.nl
# of https://example.nl/).
GSC_SERVICE_ACCOUNT_PATH=

# === E-mail voor weekrapporten ===
# Gmail: gebruik een App-wachtwoord (myaccount.google.com/apppasswords)
# Office 365: smtp.office365.com poort 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jouw@email.nl
SMTP_PASSWORD=jouw-app-wachtwoord
REPORT_EMAIL_TO=v.munster@weareimpact.nl

# === Microsoft Outlook / Graph API ===
# 1. Ga naar portal.azure.com > App registrations > New registration
# 2. Supported accounts: "Accounts in any organizational directory and personal Microsoft accounts"
# 3. Redirect URI: Public client/native > https://login.microsoftonline.com/common/oauth2/nativeclient
# 4. API permissions (Delegated): Mail.Read, Mail.ReadWrite, Mail.Send, User.Read
# 5. Kopieer Application (client) ID hieronder:
OUTLOOK_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# OUTLOOK_TENANT_ID=common   # 'common' werkt voor persoonlijke + zakelijke accounts

# === Hunter.io — e-mail lookup & verificatie voor lead outreach ===
# Maak een gratis account op hunter.io (25 zoekopdrachten + 50 verificaties/maand)
# Dashboard > API > kopieer je API-sleutel:
HUNTER_API_KEY=your-hunter-api-key-here

# === Netlify publisher ===
# Personal Access Token (app.netlify.com/user/applications). Globale fallback —
# per site kun je een eigen token zetten in het site-instellingenscherm.
NETLIFY_TOKEN=

# === Social publisher — globale fallback-credentials ===
# Per site kun je eigen tokens zetten in het site-instellingenscherm; deze
# .env-waarden worden alleen gebruikt als een site geen eigen token heeft.
#
# LinkedIn — linkedin.com/developers/tools/oauth/token-generator, scope w_member_social
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_USER_URN=
#
# Facebook — developers.facebook.com, Page Access Token met pages_manage_posts scope
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
#
# Instagram — Business/Creator-account gekoppeld aan bovenstaande Facebook-pagina
# (gebruikt hetzelfde FACEBOOK_PAGE_TOKEN)
INSTAGRAM_BUSINESS_ID=
#
# X/Twitter — developer.x.com, app met OAuth 1.0a User Context + write-toegang
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# === Social Inbox (agent leest + beantwoordt socials, met review-gate) ===
# Per-project inboxes worden aangemaakt via de UI (Social-tab) of API; deze
# .env-waarden zijn de globale fallback voor kanalen die geen eigen creds hebben.
# Facebook/Instagram delen FACEBOOK_PAGE_TOKEN (IG Business-account gekoppeld
# aan de FB-pagina). TikTok vereist een eigen geregistreerde app
# (developer.tiktok.com > Display/Content Posting API) met comment-scopes.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# === Server ===
HOST=localhost
PORT=1250

# === Agent-gedrag ===
# Synthese-taken (schrijven/redigeren) via Claude laten lopen (1) of alleen Hermes (0)
GOAL_USE_CLAUDE=1
# Strategist-doelen direct bevestigen en starten (1) of als draft laten wachten (0).
# Publiceren/versturen blijft altijd achter de menselijke Wachtrij-gate.
STRATEGIST_AUTOSTART=1
# Kwaliteitsgate content (0-100): onder deze score geen Wachtrij-review en geen publicatie
CONTENT_MIN_SCORE=85
# Minimale woorden voor een artikel (topical authority); kortere artikelen
# worden in de SEO-score zwaar afgestraft.
CONTENT_MIN_WORDS=400
# Structured data (JSON-LD: Article + FAQPage) genereren en in <head> zetten.
SEO_JSON_LD=1
# AEO / AI-Overview-optimalisatie (direct-answer + FAQ in prompts + guard).
SEO_AEO=1
# E-E-A-T-guard: claims zonder bron worden in de score afgestraft.
SEO_EEAT_GUARD=1
# Acquisitie-formule: aantal outreach-concepten per werkdag klaargezet ter review
# (versturen gebeurt NOOIT automatisch — alleen na goedkeuring in het Actiecentrum)
OUTREACH_DAILY_TARGET=10

# === Mission Radar autonomie ===
# Auto-AEO: na elke sky-scan start de agent zelfstandig AEO-aanvallen op de
# beste verse signalen (tot aan de Wachtrij-gate). Zet op 0 voor handmatig.
AEO_AUTO_ATTACK=1
# Minimale signaal-score voor een automatische AEO-aanval (hoger = conservatiever)
AEO_AUTO_MIN_SCORE=75
# Maximaal aantal auto-AEO-aanvallen per scan-run (kosten/overload-beheersing)
AEO_AUTO_MAX_PER_SCAN=3

# === Lokale fallback ===
# Als alle Hermes-backends falen, produceert de agent-runner een gemarkeerd
# CONCEPT-karkas i.p.v. de pijplijn te blokkeren. Die concepten scoren altijd
# < CONTENT_MIN_SCORE en belanden in 'needs_work' — nooit automatisch gepubliceerd.
HERMES_LOCAL_FALLBACK=1
