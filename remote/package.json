{
  "name": "impactos-remote",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Impact OS Remote — cloud-companion: review-gates goedkeuren als de pc uitstaat (Vercel + Neon).",
  "scripts": {
    "assets": "npm run assets:css && npm run assets:fonts",
    "assets:css": "tailwindcss -c tailwind.config.js -i tailwind-src.css -o tailwind.css --minify",
    "assets:fonts": "node build-fonts.mjs",
    "assets:check": "node build-fonts.mjs --check",
    "assets:icons": "../.venv/Scripts/python.exe build-icons.py",
    "dev": "node dev-server.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.0",
    "google-auth-library": "^9.14.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "tailwindcss": "^3.4.19"
  }
}
